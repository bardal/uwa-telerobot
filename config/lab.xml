<?xml version="1.0"?>
<!-- VirtualLab: simulated robot + cameras -->
<config>
  <robot>
    <controlport>30562</controlport>
    <positionport>30563</positionport>
  </robot>
  <!-- the camera server's MOM login (see users.ini) -->
