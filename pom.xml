<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>au.edu.uwa.mech</groupId>
  <artifactId>uwa-telerobot</artifactId>
  <version>2000.2-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>UWA Telerobot</name>
  <description>The 1999-2000 UWA web telerobot: MOM middleware, robot proxy, camera server and control applet, plus the web gateway</description>

  <licenses>
    <license>
      <name>GNU General Public License v2.0 or later</name>
      <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
    </license>
  </licenses>

  <!-- The lab (the 2000 code, JDK 8 source level) builds on any JDK from 8. The gateway needs JDK 21,
       so it joins the build only there: on JDK 8 (the last with appletviewer) `mvn package` builds the
       lab and the local applet; on JDK 21 it builds everything. -->
  <modules>
    <module>lab</module>
  </modules>

  <profiles>
    <profile>
      <id>gateway</id>
      <activation>
        <jdk>[21,)</jdk>
      </activation>
      <modules>
        <module>gateway</module>
      </modules>
    </profile>
  </profiles>
</project>
